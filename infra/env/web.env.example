# WitnessGrid web (Next.js PWA) — development environment
# Copy to web/.env.local when the web app lands (Task 3).

# Base URL of the WitnessGrid API service, used by the browser-side API client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Basemap tile source used by the MapLibre map (PMTiles URL).
# Config-driven: swap this for a self-hosted tileset in production if preferred.
NEXT_PUBLIC_MAP_TILES_URL=https://demo-bucket.protomaps.com/v4.pmtiles