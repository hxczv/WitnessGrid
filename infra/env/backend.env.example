# WitnessGrid API — development environment
# Copy to backend/.dev.vars when the backend workspace lands (Task 2).
# Used by the Hono API service; also consumed by infra/db scripts via DATABASE_URL.

# PostgreSQL/PostGIS connection string for the local development database.
# Required. Create the database with: createdb witnessgrid (or the PostGIS-enabled
# database of your choosing) before running `pnpm migrate` in infra/.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/witnessgrid

# Secret used to sign JWTs. MUST be at least 32 characters; do not reuse across environments.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public origin of the web client (used for CORS allow-list and safe redirect targets).
PUBLIC_ORIGIN=http://localhost:3000

# Base URL of the API service (used for magic-link URLs, verify redirects, media URLs).
BASE_URL=http://localhost:8787

# Object store backend: 'local' (filesystem under LOCAL_MEDIA_DIR) or 'r2'.
OBJECT_STORE=local

# Filesystem directory for locally stored media objects (only used when OBJECT_STORE=local).
LOCAL_MEDIA_DIR=./.media

# R2 object-store credentials — only required when OBJECT_STORE=r2.
# R2_ACCOUNT_ID=<account-id>
# R2_ACCESS_KEY_ID=<access-key-id>
# R2_SECRET_ACCESS_KEY=<secret-access-key>
# R2_BUCKET=<bucket-name>
# R2_PUBLIC_HOST=<public-host>   # public URL of the bucket/CDN if using one

# Email delivery: set RESEND_API_KEY to send real magic-link emails via Resend.
# When unset, magic links are logged to the server console (development-only mail).
RESEND_API_KEY=
EMAIL_FROM=WitnessGrid <noreply@witnessgrid.app>

# Validity window for magic-link tokens, in minutes.
MAGIC_LINK_TTL_MINUTES=15