# WitnessGrid web — environment
# Copy to .env.local for local development.

# Base URL of the WitnessGrid API, as seen by the browser.
# In development the backend runs at http://localhost:8787.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Server-only override for API calls made during SSR. Falls back to
# NEXT_PUBLIC_API_BASE_URL when unset. Useful when the server can reach the
# API on a different address than the browser (e.g. inside Docker).
API_BASE_URL=http://localhost:8787

# Public URL of this web app. Used for canonical links, the sitemap and
# Open Graph metadata. Set it in every deployed environment — otherwise
# these fall back to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Raster basemap tiles, as a {z}/{x}/{y} template. Defaults to OpenStreetMap.
# Vector/PMTiles archives are not supported.
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
