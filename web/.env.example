# WitnessGrid web — environment
# Copy to .env.local for local development.

# Base URL of the WitnessGrid API (browser-facing; used by client code).
# In development the Hono backend runs at http://localhost:8787.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Server-only override for API calls made during SSR. Falls back to
# NEXT_PUBLIC_API_BASE_URL when unset.
API_BASE_URL=http://localhost:8787

# Public PMTiles basemap used by the map page (config-driven).
NEXT_PUBLIC_MAP_TILES_URL=https://demo-bucket.protomaps.com/v4.pmtiles