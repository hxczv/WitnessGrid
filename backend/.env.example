# WitnessGrid backend — environment
# Copy to .env for local development. Every value below is either safe for
# local use or a placeholder you MUST replace before deploying.

# Postgres connection string (PostGIS extension required).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/witnessgrid

# HS256 signing secret for session JWTs. The placeholder below fails startup
# validation on purpose — generate a real one with: openssl rand -hex 32
JWT_SECRET=CHANGE-ME

# Public URL of the web app. Sign-in emails link here.
PUBLIC_ORIGIN=http://localhost:3000

# Public URL of this API. Used for upload endpoints in emails/clients and as
# the local-mode upload_url. Must be an absolute http(s) URL.
BASE_URL=http://localhost:8787

# Object store: "local" (filesystem, default) or "r2" (Cloudflare R2 via S3 API).
OBJECT_STORE=local

# Where local-mode media objects are stored.
LOCAL_MEDIA_DIR=./.media

# Required when OBJECT_STORE=r2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Email delivery via Resend. When unset, mail is logged to .dev-mail.log
# instead of sent — fine locally, not fine in production.
# RESEND_API_KEY=
EMAIL_FROM=WitnessGrid <noreply@witnessgrid.app>

# How long magic links stay valid.
MAGIC_LINK_TTL_MINUTES=15

# Runtime platform: "node" (default) or "workers" (set by the Workers entry).
# PLATFORM=node

# HTTP port for the Node server.
PORT=8787
