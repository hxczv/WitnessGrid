    "@hono/node-server": "^1.13.0",
    "@witnessgrid/contract": "workspace:*",
    "hono": "^4.6.9",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
